{
  "name": "emrefbulut-profile",
  "version": "1.0.0",
  "private": true,
  "description": "Generators for the self-hosted assets used by the emrefbulut profile README",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "badges": "node tools/gen-badges.js",
    "typing": "node tools/gen-typing.js",
    "stats": "node tools/gen-stats.js",
    "check": "node tools/check-svg.js",
