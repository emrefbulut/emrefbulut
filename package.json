  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emrefbulut/emrefbulut.git"
  },
  "dependencies": {
    "badge-maker": "^6.0.0",
    "fast-xml-parser": "^5.11.0",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
